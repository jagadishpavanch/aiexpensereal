<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: keep everything out of cloud backup and device-to-device transfer. The app's storage holds
     the sign-in token, every transaction and the queue of bank alert texts; the account syncs through Supabase. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
